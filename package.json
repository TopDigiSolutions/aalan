{
  "name": "sitedrop-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:ui": "vitest run",
    "format": "prettier --write src server shared docs *.json *.ts *.md index.html"
  },
  "engines": {
    "node": "24.x"
